{
  "name": "@trivoallan/ontrack-engineering",
  "version": "0.7.0",
  "description": "Engineering conventions your repositories import as ADRs: commits, branching, delivery, supply chain, coding agents. Checked in CI.",
  "license": "MIT-0",
  "keywords": [
    "ontrack",
    "ontrack-tracks",
    "adr",
    "architecture-decision-records",
    "engineering-standards",
    "conventions",
    "supply-chain-security",
    "slsa",
    "sbom",
    "ci",
    "github-actions",
    "coding-agents",
    "claude-code",
    "typescript",
    "python"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trivoallan/ontrack-engineering.git"
  },
  "type": "module",
  "files": [
    "adr/",
    "dist/ontrack-engineering-check.js"
  ],
  "bin": {
    "ontrack-engineering-check": "dist/ontrack-engineering-check.js",
    "governance-check": "dist/ontrack-engineering-check.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.2",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "tsc",
    "hooks": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "prepare": "npm run build && npm run hooks",
    "test": "tsc --noEmit && node --test --experimental-test-coverage --test-coverage-include='checks/*.ts' --test-coverage-exclude='checks/*.test.ts' --test-coverage-exclude='checks/test-helpers.ts' --test-coverage-lines=90 checks/*.test.ts",
    "about": "gh repo edit --description \"$(node -p 'require(\"./package.json\").description')\" && node -p 'JSON.stringify({names: require(\"./package.json\").keywords})' | gh api -X PUT 'repos/{owner}/{repo}/topics' --input - --silent"
  },
  "ontrack": {
    "adr": "adr",
    "namespace": "trivoallan"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@fission-ai/openspec": "1.13.1",
    "@trivoallan/ontrack": "^0.6.0",
    "@types/node": "22.20.5",
    "trivoallan": "npm:@trivoallan/ontrack-engineering@^0.6.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@jackchuka/mdschema": "0.16.0",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "@jackchuka/mdschema": false
  }
}
